{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.backend"
  },
  "deploy": {
    "startCommand": "sh -c \"uvicorn src.api.app:app --host 0.0.0.0 --port ${PORT:-8000}\"",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300
  }
}